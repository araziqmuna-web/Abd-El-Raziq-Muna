---
import site from "../data/site.json";
const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/research/", label: "Research" },
  { href: "/publications/", label: "Publications" },
  { href: "/teaching/", label: "Teaching" },
  { href: "/contact/", label: "Contact" },
];
const path = Astro.url.pathname.replace(/\/?$/, "/");
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="sticky top-0 z-20 bg-paper/95 backdrop-blur border-b border-rule dark:bg-night/95 dark:border-night-rule" style="padding-top: env(safe-area-inset-top, 0px)">
  <div class="mx-auto max-w-5xl px-5 sm:px-6 h-16 flex items-center gap-4">
    <a href="/" class="font-serif text-lg sm:text-xl font-semibold tracking-tight mr-auto text-ink dark:text-night-ink no-underline">{site.name}</a>

    <nav aria-label="Main" class="hidden md:flex gap-6 text-[15px]">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={isActive(l.href) ? "page" : undefined}
          class="text-muted hover:text-ink dark:text-night-muted dark:hover:text-night-ink aria-[current=page]:text-ink dark:aria-[current=page]:text-night-ink aria-[current=page]:underline decoration-accent dark:decoration-night-accent decoration-2"
        >{l.label}</a>
      ))}
    </nav>

    <button id="theme-toggle" type="button" aria-label="Switch between light and dark mode"
      class="size-9 grid place-items-center rounded-full border border-rule dark:border-night-rule hover:border-accent dark:hover:border-night-accent">
      <svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="size-[18px] hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>

    <button id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu"
      class="md:hidden size-9 grid place-items-center rounded-full border border-rule dark:border-night-rule">
      <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Main" class="md:hidden hidden border-t border-rule dark:border-night-rule">
    <ul class="mx-auto max-w-5xl px-5 py-2">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}
            class="block py-3 text-lg border-b border-rule/60 dark:border-night-rule/60 last:border-0 aria-[current=page]:text-accent dark:aria-[current=page]:text-night-accent">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;
    document.getElementById("theme-toggle").addEventListener("click", function () {
      var dark = !root.classList.contains("dark");
      root.classList.toggle("dark", dark);
      try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) {}
    });
    var btn = document.getElementById("menu-toggle");
    var nav = document.getElementById("mobile-nav");
    btn.addEventListener("click", function () {
      var open = btn.getAttribute("aria-expanded") !== "true";
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      nav.classList.toggle("hidden", !open);
    });
  })();
</script>
