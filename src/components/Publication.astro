---
interface Pub {
  year: number; status: string; title: string; authors: string; venue: string;
  doi: string; openAccess: boolean; topics: string[]; summary: string;
}
interface Props { pub: Pub; showSummary?: boolean }
const { pub, showSummary = true } = Astro.props;
// Bold Muna's name in the author list
const authors = pub.authors.replace(/Abd El-Raziq, M\.\*?/g, (m) => `<strong class="font-semibold text-ink dark:text-night-ink">${m}</strong>`);
const link = pub.doi ? `https://doi.org/${pub.doi}` : "";
---
<article class="py-6 border-b border-rule dark:border-night-rule" data-topics={pub.topics.join("|")}>
  <h3 class="font-serif text-lg sm:text-xl font-semibold leading-snug">
    {link ? <a href={link} class="hover:text-accent dark:hover:text-night-accent hover:underline">{pub.title}</a> : pub.title}
  </h3>
  <p class="mt-1.5 text-[15px] text-muted dark:text-night-muted" set:html={authors} />
  <p class="mt-1 text-[15px] text-muted dark:text-night-muted">
    {pub.venue && <em>{pub.venue}</em>}
    {pub.status !== "published" && <span class="ml-1 inline-block text-xs font-semibold border border-rule dark:border-night-rule rounded px-1.5 py-0.5 align-middle">{pub.status}</span>}
    {pub.openAccess && <span class="ml-1 text-accent dark:text-night-accent font-medium">Open access</span>}
  </p>
  <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
    {pub.topics.map((t) => <span class="text-muted dark:text-night-muted">{t}</span>)}
  </div>
  {showSummary && pub.summary && (
    <details class="mt-3 group">
      <summary class="cursor-pointer text-sm font-semibold text-accent dark:text-night-accent list-none">
        <span class="group-open:hidden">Read the summary</span><span class="hidden group-open:inline">Hide the summary</span>
      </summary>
      <p class="mt-2 max-w-[65ch]">{pub.summary}</p>
    </details>
  )}
</article>
