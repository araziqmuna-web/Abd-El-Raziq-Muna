---
import "../styles/global.css";
import Header from "../components/Header.astro";
import site from "../data/site.json";

interface Props { title?: string; description?: string }
const { title, description = "Linguist and speech-language pathologist studying language in Arabic-speaking autistic children." } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.credentials}`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Figtree:wght@400;500;600&family=Noto+Naskh+Arabic:wght@500&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15181f" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply the saved or system theme before the page paints (no flash)
      (function () {
        try {
          var t = localStorage.getItem("theme");
          var dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans text-[17px] leading-relaxed dark:bg-night dark:text-night-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 bg-accent text-white px-3 py-2 rounded">Skip to content</a>
    <Header />
    <main id="main" class="mx-auto max-w-3xl px-5 sm:px-6 pt-12 pb-20 sm:pt-16">
      <slot />
    </main>
    <footer class="border-t border-rule dark:border-night-rule">
      <div class="mx-auto max-w-3xl px-5 sm:px-6 py-8 text-sm text-muted dark:text-night-muted flex flex-wrap gap-x-6 gap-y-2 justify-between">
        <span>© {year} {site.name}</span>
        <span class="flex gap-5">
          <a class="hover:text-accent dark:hover:text-night-accent" href={`mailto:${site.email}`}>Email</a>
          <a class="hover:text-accent dark:hover:text-night-accent" href={site.orcid}>ORCID</a>
        </span>
      </div>
    </footer>
  </body>
</html>
