---
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import Section from "../components/Section.astro";
import Row from "../components/Row.astro";
import talks from "../data/talks.json";

const themes = [
  { title: "Language profiles in autism", text: "Not every autistic child has the same language strengths and needs. Using sentence repetition, non-word repetition, and vocabulary tasks, I map which language areas are spared or affected in each child, and I use cluster analysis to find distinct profiles." },
  { title: "Arabic diglossia", text: "Arabic-speaking children grow up with a spoken dialect at home and Modern Standard Arabic at school. I study how this shapes vocabulary learning in autism, including which variety of Arabic autistic children prefer to use." },
  { title: "Language, theory of mind, and cognition", text: "How does language relate to understanding other people’s minds, executive functions, and nonverbal reasoning? Network analyses suggest language sits at the center of these skills in autistic children." },
  { title: "Bilingualism and memory", text: "With colleagues in Fribourg, I compare monolingual and bilingual autistic children to see how working memory and bilingual experience relate to understanding complex sentences." },
];
---
<Base title="Research">
  <PageTitle title="Research" intro="I study language development in autistic children, with a focus on Palestinian Arabic, a language that has been underrepresented in autism research." />

  <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
    {themes.map((t) => (
      <div class="border-t-2 border-accent dark:border-night-accent pt-4">
        <h2 class="font-serif text-xl font-semibold mb-2">{t.title}</h2>
        <p>{t.text}</p>
      </div>
    ))}
  </div>

  <Section title="Current projects">
    <Row when="NYU"><p>Two-word combinations in autistic and typically developing preschoolers, with Prof. Sudha Arunachalam and Prof. Rhiannon Luyster.</p></Row>
    <Row when="NYU"><p>Lexical abilities in Arabic–English bilingual children, measured with eye-tracking and caregiver reports.</p></Row>
    <Row when="Bar-Ilan"><p>Morpho-lexical and morpho-syntactic development in Arabic-speaking toddlers, an Israel Science Foundation project with Prof. Elinor Saiegh-Haddad.</p></Row>
  </Section>

  <Section title="Selected talks">
    <p class="text-muted dark:text-night-muted mb-2">8 invited talks, 23 conference talks, and 14 posters to date.</p>
    {talks.map((t) => (
      <Row when={t.date}>
        <p class="text-sm font-semibold text-accent dark:text-night-accent">{t.type}</p>
        <p class="font-medium">{t.title}</p>
        <p class="text-[15px] text-muted dark:text-night-muted">{t.where}</p>
      </Row>
    ))}
  </Section>
</Base>
