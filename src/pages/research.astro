---
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import Section from "../components/Section.astro";
import Row from "../components/Row.astro";
import Publication from "../components/Publication.astro";
import talks from "../data/talks.json";
import pubs from "../data/publications.json";

// Each research theme has its own color (same colors as the publication labels).
// "wide: true" makes a card stretch across the whole row.
const themes = [
  {
    title: "Arabic as a natural test case",
    label: "Diglossia",
    wide: true,
    card: "bg-[#e3f1eb] border-[#3f8a72] dark:bg-[#1c2f29] dark:border-[#7cc4aa]",
    pill: "bg-[#d7ebe3] text-[#22594a] dark:bg-[#1f3a32] dark:text-[#b5e3d2]",
    text: "Arabic-speaking children grow up with two language varieties: a spoken dialect for everyday talk, and Modern Standard Arabic for formal speech, reading, and writing. In my studies, all children used the spoken dialect most of the time. Yet some autistic children, especially those with age-appropriate language, chose Modern Standard Arabic words even when telling an everyday story, where the spoken dialect is expected. This may point to pragmatic challenges, and shows what Arabic can reveal about language in autism.",
  },
  {
    title: "Many language profiles",
    label: "Morphosyntax and phonology",
    card: "bg-[#efe7f6] border-[#8a63b3] dark:bg-[#2a2333] dark:border-[#b597d6]",
    pill: "bg-[#e6dcf0] text-[#59397a] dark:bg-[#352b40] dark:text-[#dcc8f0]",
    text: "In phonology, 72% of the autistic children repeated new words like their typically developing peers, while 28% were at risk for phonological impairment. In grammar, 57% showed difficulties. A cluster analysis found four distinct language profiles, so a child can be strong in one area and struggle in another.",
  },
  {
    title: "Vocabulary differs too",
    label: "Vocabulary",
    card: "bg-[#f7eedd] border-[#b8862f] dark:bg-[#2f2818] dark:border-[#e0bd7a]",
    pill: "bg-[#f1e1c2] text-[#6a4b12] dark:bg-[#3d331f] dark:text-[#f0d79f]",
    text: "Autistic children with age-appropriate language understood and named as many nouns and verbs as their typically developing peers. Autistic children with language impairment knew fewer words. Like sounds and grammar, vocabulary varies from one autistic child to the next.",
  },
  {
    title: "Language, theory of mind, and cognition",
    label: "Cognition",
    card: "bg-[#f8e7e4] border-[#c0604f] dark:bg-[#33221f] dark:border-[#e59a8c]",
    pill: "bg-[#f3dad6] text-[#7a3127] dark:bg-[#40272a] dark:text-[#f2c1b9]",
    text: "In autistic children, language skills, especially pragmatics, sat at the center of the network linking language, theory of mind, and cognition. Children with stronger language also did better on theory of mind and executive function tasks.",
  },
  {
    title: "Bilingualism and memory",
    label: "Bilingualism",
    card: "bg-[#e6eef8] border-[#4a77b4] dark:bg-[#1d2738] dark:border-[#8fb2e3]",
    pill: "bg-[#dbe6f4] text-[#264d7a] dark:bg-[#223250] dark:text-[#bcd2f2]",
    text: "With colleagues in Fribourg, I studied 55 monolingual and bilingual autistic children speaking French or German. Better phonological working memory predicted better understanding of complex sentences, and more exposure to the test language helped with the hardest ones. Bilingualism did not hinder comprehension, which supports keeping both languages in autistic children’s lives.",
  },
  {
    title: "From my clinical work: strong interests",
    label: "Clinical observation",
    wide: true,
    card: "bg-[#fbf3e4] border-[#c9973f] border-dashed dark:bg-[#2c2517] dark:border-[#e0bd7a]",
    pill: "bg-[#f1e1c2] text-[#6a4b12] dark:bg-[#3d331f] dark:text-[#f0d79f]",
    text: "As a speech-language pathologist, I have seen that a child’s fascination with a favorite topic, like a video game, is often described only as repetitive behavior. In the children I work with, it can also reveal vocabulary, curiosity, and learning. This is not yet a research finding, but a question I hope to study in the future: can strong interests open a way into language?",
  },
];

// Colors for the talk labels
const talkColors: Record<string, string> = {
  Invited: "bg-[#dbe6f4] text-[#264d7a] dark:bg-[#223250] dark:text-[#bcd2f2]",
  Talk:    "bg-[#e6dcf0] text-[#59397a] dark:bg-[#352b40] dark:text-[#dcc8f0]",
  Poster:  "bg-[#f1e1c2] text-[#6a4b12] dark:bg-[#3d331f] dark:text-[#f0d79f]",
};
const neutral = "bg-[#e8e6dc] text-[#4f4c3a] dark:bg-[#33322a] dark:text-[#dedac6]";
---
<Base title="Research">
  <PageTitle title="Research" />

  <p class="font-serif text-2xl sm:text-3xl leading-snug max-w-[30ch]">
    Autistic children show many different language profiles. I want to understand the pathways that lead to them.
  </p>

  <div class="mt-6 space-y-4 max-w-[65ch]">
    <p>Autism research has often described language as if autistic children shared a single profile. As a speech-language pathologist, I kept meeting children who didn’t fit that picture. Some communicated through their strongest interests. Some used Modern Standard Arabic where other children use their spoken dialect. Others understood much more than standard language measures suggested.</p>
    <p>These clinical experiences shaped my research. My studies examine the different language profiles of Arabic-speaking autistic children, in morphosyntax, phonology, and vocabulary, and how these relate to theory of mind and other cognitive skills. My next goal is to understand the <strong class="font-semibold">pathways behind these profiles</strong>: how each child’s language develops over time, and what shapes these differences.</p>
  </div>

  <figure class="my-10 border-l-4 border-accent dark:border-night-accent pl-5 sm:pl-6">
    <blockquote class="font-serif text-lg sm:text-xl leading-relaxed space-y-1">
      <p>“What does love feel like?”</p>
      <p>“Excitement.”</p>
      <p>“What does excitement feel like?”</p>
      <p>“I can’t wait to learn everything about <em>God of War</em>.”</p>
    </blockquote>
    <figcaption class="mt-3 text-[15px] text-muted dark:text-night-muted">A conversation with a six-year-old autistic boy, from my clinical work as a speech-language pathologist. Moments like this shaped the questions I ask in my research.</figcaption>
  </figure>

  <div class="grid gap-5 sm:grid-cols-2">
    {themes.map((t) => (
      <div class={`rounded-2xl border-t-4 p-6 ${t.card} ${t.wide ? "sm:col-span-2" : ""}`}>
        <span class={`inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold ${t.pill}`}>{t.label}</span>
        <h2 class="font-serif text-xl font-semibold mt-3 mb-2">{t.title}</h2>
        <p>{t.text}</p>
      </div>
    ))}
  </div>

  <Section title="Why it matters">
    <p class="max-w-[65ch]">Mothers have often asked me, “Why doesn’t anyone understand my child?” Part of the answer may be that we have been looking for one expected profile instead of recognizing many. When assessment and support reflect each child’s own language profile, families and clinicians can understand communication better, and researchers can build more accurate theories of language development in autism.</p>
  </Section>

  <Section title="Research stories">
    <a href="/stories/sentence-repetition/" class="block rounded-2xl border-t-4 border-[#8a63b3] dark:border-[#b597d6] bg-[#efe7f6] dark:bg-[#2a2333] p-6 no-underline hover:shadow-md transition-shadow">
      <span class="inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold bg-[#e6dcf0] text-[#59397a] dark:bg-[#352b40] dark:text-[#dcc8f0]">Interactive</span>
      <h3 class="font-serif text-xl font-semibold mt-3 mb-1">Can you say it back?</h3>
      <p>Scroll through one of my studies: the original abstract on one side, and what it means in plain language on the other.</p>
      <p class="mt-3 font-semibold text-accent dark:text-night-accent">Read the story →</p>
    </a>
  </Section>

  <Section title="Current projects">
    <Row when="NYU"><p>Two-word combinations in autistic and typically developing preschoolers, with Prof. Sudha Arunachalam and Prof. Rhiannon Luyster.</p></Row>
    <Row when="NYU"><p>Lexical abilities in Arabic–English bilingual children, measured with eye-tracking and caregiver reports.</p></Row>
    <Row when="Bar-Ilan"><p>Morpho-lexical and morpho-syntactic development in Arabic-speaking toddlers, an Israel Science Foundation project with Prof. Elinor Saiegh-Haddad.</p></Row>
  </Section>

  <Section title="Publications">
    {pubs.filter((p) => p.status === "published").map((p) => <Publication pub={p} />)}
  </Section>

  <Section title="Selected talks">
    <div class="flex flex-wrap gap-x-8 gap-y-3 mb-4">
      <div><span class="font-serif text-3xl font-semibold">8</span> <span class="text-muted dark:text-night-muted">invited talks</span></div>
      <div><span class="font-serif text-3xl font-semibold">23</span> <span class="text-muted dark:text-night-muted">conference talks</span></div>
      <div><span class="font-serif text-3xl font-semibold">14</span> <span class="text-muted dark:text-night-muted">posters</span></div>
    </div>
    {talks.map((t) => (
      <Row when={t.date}>
        <span class={`inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold ${talkColors[t.type] ?? neutral}`}>{t.type}</span>
        <p class="font-medium mt-1.5">{t.title}</p>
        <p class="text-[15px] text-muted dark:text-night-muted">{t.where}</p>
      </Row>
    ))}
  </Section>
</Base>
