---
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import Section from "../components/Section.astro";
import Row from "../components/Row.astro";
import Publication from "../components/Publication.astro";
import talks from "../data/talks.json";
import pubs from "../data/publications.json";

// The page tells one story in four parts. Each part has its own color.
const c = {
  clinic:   { dot: "bg-[#b8862f] text-white dark:bg-[#e0bd7a] dark:text-[#2f2818]", card: "bg-[#f7eedd] border-[#b8862f] dark:bg-[#2f2818] dark:border-[#e0bd7a]", pill: "bg-[#f1e1c2] text-[#6a4b12] dark:bg-[#3d331f] dark:text-[#f0d79f]" },
  arabic:   { dot: "bg-[#3f8a72] text-white dark:bg-[#7cc4aa] dark:text-[#1c2f29]", card: "bg-[#e3f1eb] border-[#3f8a72] dark:bg-[#1c2f29] dark:border-[#7cc4aa]", pill: "bg-[#d7ebe3] text-[#22594a] dark:bg-[#1f3a32] dark:text-[#b5e3d2]" },
  profiles: { dot: "bg-[#8a63b3] text-white dark:bg-[#b597d6] dark:text-[#2a2333]", card: "bg-[#efe7f6] border-[#8a63b3] dark:bg-[#2a2333] dark:border-[#b597d6]", pill: "bg-[#e6dcf0] text-[#59397a] dark:bg-[#352b40] dark:text-[#dcc8f0]" },
  research: { dot: "bg-[#4a77b4] text-white dark:bg-[#8fb2e3] dark:text-[#1d2738]", card: "bg-[#e6eef8] border-[#4a77b4] dark:bg-[#1d2738] dark:border-[#8fb2e3]", pill: "bg-[#dbe6f4] text-[#264d7a] dark:bg-[#223250] dark:text-[#bcd2f2]" },
};

// The pipeline steps, with small drawn icons
const stroke = 'fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"';
const steps = [
  {---
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import Section from "../components/Section.astro";
import Row from "../components/Row.astro";
import Publication from "../components/Publication.astro";
import talks from "../data/talks.json";
import pubs from "../data/publications.json";

// The page tells one story in four parts. Each part has its own color.
const c = {
  clinic:   { dot: "bg-[#b8862f] text-white dark:bg-[#e0bd7a] dark:text-[#2f2818]", card: "bg-[#f7eedd] border-[#b8862f] dark:bg-[#2f2818] dark:border-[#e0bd7a]", pill: "bg-[#f1e1c2] text-[#6a4b12] dark:bg-[#3d331f] dark:text-[#f0d79f]" },
  arabic:   { dot: "bg-[#3f8a72] text-white dark:bg-[#7cc4aa] dark:text-[#1c2f29]", card: "bg-[#e3f1eb] border-[#3f8a72] dark:bg-[#1c2f29] dark:border-[#7cc4aa]", pill: "bg-[#d7ebe3] text-[#22594a] dark:bg-[#1f3a32] dark:text-[#b5e3d2]" },
  profiles: { dot: "bg-[#8a63b3] text-white dark:bg-[#b597d6] dark:text-[#2a2333]", card: "bg-[#efe7f6] border-[#8a63b3] dark:bg-[#2a2333] dark:border-[#b597d6]", pill: "bg-[#e6dcf0] text-[#59397a] dark:bg-[#352b40] dark:text-[#dcc8f0]" },
  research: { dot: "bg-[#4a77b4] text-white dark:bg-[#8fb2e3] dark:text-[#1d2738]", card: "bg-[#e6eef8] border-[#4a77b4] dark:bg-[#1d2738] dark:border-[#8fb2e3]", pill: "bg-[#dbe6f4] text-[#264d7a] dark:bg-[#223250] dark:text-[#bcd2f2]" },
};

// The pipeline steps, with small drawn icons
const stroke = 'fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"';
const steps = [
  {
    id: "arabic", title: "Arabic", note: "Who I am, and my language",
    ring: "bg-[#e3f1eb] border-[#3f8a72] text-[#22594a] dark:bg-[#1c2f29] dark:border-[#7cc4aa] dark:text-[#b5e3d2]",
    // two overlapping speech bubbles with Arabic letters
    icon: `<svg viewBox="0 0 48 48" width="46" height="46" ${stroke}><path d="M5 9h20a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H13l-6 5v-5H5a3 3 0 0 1-3-3v-9a3 3 0 0 1 3-3z"/><path d="M23 24h20a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-2v5l-6-5H23a3 3 0 0 1-3-3"/><text x="15" y="20" font-size="10" text-anchor="middle" fill="currentColor" stroke="none" font-family="serif">ع</text><text x="33" y="35" font-size="10" text-anchor="middle" fill="currentColor" stroke="none" font-family="serif">ض</text></svg>`,
  },
  {
    id: "clinic", title: "Clinic", note: "What children showed me",
    ring: "bg-[#f7eedd] border-[#b8862f] text-[#8a5f17] dark:bg-[#2f2818] dark:border-[#e0bd7a] dark:text-[#f0d79f]",
    // a child with a speech bubble
    icon: `<svg viewBox="0 0 48 48" width="46" height="46" ${stroke}><circle cx="16" cy="16" r="6"/><path d="M6 40c0-6 4.5-10 10-10s10 4 10 10"/><path d="M27 8h14a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-7l-5 4v-4h-2a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3z"/><path d="M31 14h6"/></svg>`,
  },
  {
    id: "profiles", title: "Profiles", note: "What my research found",
    ring: "bg-[#efe7f6] border-[#8a63b3] text-[#59397a] dark:bg-[#2a2333] dark:border-[#b597d6] dark:text-[#dcc8f0]",
    // bars of different heights
    icon: `<svg viewBox="0 0 48 48" width="46" height="46" ${stroke}><path d="M6 42h36"/><rect x="9" y="22" width="7" height="20" rx="1.5"/><rect x="20.5" y="10" width="7" height="32" rx="1.5"/><rect x="32" y="28" width="7" height="14" rx="1.5"/></svg>`,
  },
  {
    id: "next", title: "Pathways", note: "How language develops",
    ring: "bg-[#e6eef8] border-[#4a77b4] text-[#264d7a] dark:bg-[#1d2738] dark:border-[#8fb2e3] dark:text-[#bcd2f2]",
    // one path branching into three
    icon: `<svg viewBox="0 0 48 48" width="46" height="46" ${stroke}><circle cx="8" cy="24" r="3.5"/><path d="M11.5 24h8c5 0 6-12 12-12h6"/><path d="M11.5 24h26"/><path d="M19.5 24c5 0 6 12 12 12h6"/><circle cx="40" cy="12" r="2.5"/><circle cx="40" cy="24" r="2.5"/><circle cx="40" cy="36" r="2.5"/></svg>`,
  },
];

// Results for part 3: share of autistic children with age-appropriate skills
const profiles = [
  { area: "Sounds (non-word repetition)", ok: 72 },
  { area: "Grammar (sentence repetition)", ok: 43 },
];

// Colors for the talk labels
const talkColors: Record<string, string> = {
  Invited: "bg-[#dbe6f4] text-[#264d7a] dark:bg-[#223250] dark:text-[#bcd2f2]",
  Talk:    "bg-[#e6dcf0] text-[#59397a] dark:bg-[#352b40] dark:text-[#dcc8f0]",
  Poster:  "bg-[#f1e1c2] text-[#6a4b12] dark:bg-[#3d331f] dark:text-[#f0d79f]",
};
const neutral = "bg-[#e8e6dc] text-[#4f4c3a] dark:bg-[#33322a] dark:text-[#dedac6]";
---
<Base title="Research">
  <PageTitle title="Research" />

  <p class="font-serif text-2xl sm:text-3xl leading-snug max-w-[30ch]">
    Autistic children show many different language profiles. I want to understand the pathways that lead to them.
  </p>
  <p class="mt-5 max-w-[62ch] text-muted dark:text-night-muted">My research brings together who I am and what I have seen. Here is the story in four parts: my language, my clinical work, what my studies found, and where my research goes next.</p>

  <!-- THE PIPELINE: four steps from clinic to research. Each step links to its part below. -->
  <nav aria-label="The four parts of my research" class="mt-10">
    <ol class="grid grid-cols-1 sm:grid-cols-4 gap-3 sm:gap-0">
      {steps.map((st, i) => (
        <li class="relative flex sm:flex-col items-center sm:text-center gap-4 sm:gap-3 sm:px-2">
          {i < steps.length - 1 && (
            <span aria-hidden="true" class="hidden sm:block absolute top-[46px] left-[calc(50%+52px)] right-[calc(-50%+52px)] h-[3px] rounded-full bg-gradient-to-r from-[#c9b8de] to-[#c9b8de] dark:from-[#4a3f5a] dark:to-[#4a3f5a]">
              <span class="absolute -right-1 -top-[5px] text-[#8a63b3] dark:text-[#b597d6] text-sm leading-none">▶</span>
            </span>
          )}
          {i < steps.length - 1 && (
            <span aria-hidden="true" class="sm:hidden absolute left-[45px] top-[92px] h-3 w-[3px] rounded-full bg-[#c9b8de] dark:bg-[#4a3f5a]"></span>
          )}
          <a href={`#${st.id}`} class={`shrink-0 size-[92px] rounded-full grid place-items-center border-4 hover:scale-105 transition-transform ${st.ring}`} aria-label={`Part ${i + 1}: ${st.title}`}>
            <Fragment set:html={st.icon} />
          </a>
          <div>
            <p class="text-xs font-semibold text-muted dark:text-night-muted">Part {i + 1}</p>
            <a href={`#${st.id}`} class="font-serif text-lg font-semibold leading-snug hover:underline">{st.title}</a>
            <p class="text-[14px] text-muted dark:text-night-muted leading-snug mt-0.5">{st.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </nav>


  <!-- PART 1: ARABIC (who I am) -->
  <section id="arabic" class="mt-14 scroll-mt-24">
    <div class="flex items-center gap-3 mb-4">
      <span class={`size-9 rounded-full grid place-items-center font-semibold ${c.arabic.dot}`}>1</span>
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold">Who I am: a native Arabic speaker</h2>
    </div>
    <div class={`rounded-2xl border-t-4 p-6 ${c.arabic.card}`}>
      <span class={`inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold ${c.arabic.pill}`}>Arabic and diglossia</span>
      <p class="mt-3">Arabic is my native language. Like every Arabic-speaking child, I grew up with two varieties: a spoken dialect for everyday talk, and Modern Standard Arabic for school, books, and formal speech. This is called diglossia.</p>
      <p class="mt-3">Most of what we know about language in autism comes from English. Arabic, spoken by over 400 million people, has been studied very little. Its two varieties and rich word structure make it a revealing language for testing theories built on English, and for asking new questions.</p>
    </div>
  </section>

  <!-- PART 2: CLINIC -->
  <section id="clinic" class="mt-14 scroll-mt-24">
    <div class="flex items-center gap-3 mb-4">
      <span class={`size-9 rounded-full grid place-items-center font-semibold ${c.clinic.dot}`}>2</span>
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold">It started in the clinic</h2>
    </div>
    <div class="space-y-4 max-w-[65ch]">
      <p>As a speech-language pathologist, I kept meeting autistic children who didn’t fit the picture in textbooks. They surprised me with their humor, their creativity, and their unexpected ways of using language. Some communicated through their strongest interests. Some used Modern Standard Arabic in everyday conversation, where other children would use their dialect. Others understood much more than standard language tests suggested.</p>
    </div>
    <figure class={`mt-6 rounded-2xl border-l-4 p-6 ${c.clinic.card}`}>
      <span class={`inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold ${c.clinic.pill}`}>From my clinical work</span>
      <blockquote class="mt-4 font-serif text-lg sm:text-xl leading-relaxed space-y-1">
        <p>“What does love feel like?”</p>
        <p>“Excitement.”</p>
        <p>“What does excitement feel like?”</p>
        <p>“I can’t wait to learn everything about <em>God of War</em>.”</p>
      </blockquote>
      <figcaption class="mt-4 text-[15px]">A six-year-old autistic boy explained a feeling through the video game he loved. His fascination is often described only as a repetitive interest, but here it carried vocabulary, curiosity, and a creative way of making meaning. Moments like this showed me that autistic children’s language is richer than one profile can describe.</figcaption>
    </figure>
  </section>

  <!-- PART 3: PROFILES -->
  <section id="profiles" class="mt-14 scroll-mt-24">
    <div class="flex items-center gap-3 mb-4">
      <span class={`size-9 rounded-full grid place-items-center font-semibold ${c.profiles.dot}`}>3</span>
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold">What my research found</h2>
    </div>
    <p class="max-w-[65ch]">In my PhD, I tested sounds, grammar, and vocabulary in Palestinian-Arabic-speaking children with and without autism. In every area, some autistic children performed like their typically developing peers, while others showed difficulties.</p>
    <div class={`mt-5 rounded-2xl border-t-4 p-6 ${c.profiles.card}`}>
      <p class="text-sm font-semibold mb-3">Autistic children with age-appropriate skills</p>
      <div class="space-y-4">
        {profiles.map((pr) => (
          <div>
            <div class="flex justify-between text-[15px]"><span>{pr.area}</span><span class="font-semibold">{pr.ok}%</span></div>
            <div class="h-3 rounded-full bg-white/70 dark:bg-white/10 mt-1.5"><div class="h-3 rounded-full bg-[#8a63b3] dark:bg-[#b597d6]" style={`width:${pr.ok}%`}></div></div>
          </div>
        ))}
        <div>
          <div class="flex justify-between text-[15px]"><span>Vocabulary (understanding and naming words)</span><span class="font-semibold">two profiles</span></div>
          <p class="text-[15px] mt-1">Children with age-appropriate language knew as many words as their typically developing peers; children with language impairment knew fewer.</p>
        </div>
      </div>
      <p class="mt-5 pt-4 border-t border-[#8a63b3]/30 dark:border-[#b597d6]/30"><span class="font-semibold">Arabic in storytelling:</span> 57 children told a picture story in Spoken Arabic, 19 in each group. Spoken Arabic predominated in all three groups. A minority of children in every group preferred Modern Standard Arabic, most often autistic children with age-appropriate language (4 of 19, compared with 1 of 19 in each of the other groups; a descriptive difference only). Whether this reflects a linguistic strength, a preference for the formal variety, or pragmatic differences remains an open question.</p>
      <p class="mt-5 pt-4 border-t border-[#8a63b3]/30 dark:border-[#b597d6]/30"><span class="font-semibold">Four profiles:</span> a cluster analysis found one group strong across language areas and three groups with different strengths and weaknesses. A child can be strong in sounds and vocabulary, yet struggle with grammar.</p>
    </div>
  </section>

  <!-- PART 4: RESEARCH -->
  <section id="next" class="mt-14 scroll-mt-24">
    <div class="flex items-center gap-3 mb-4">
      <span class={`size-9 rounded-full grid place-items-center font-semibold ${c.research.dot}`}>4</span>
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold">Where my research goes</h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class={`rounded-2xl border-t-4 p-6 ${c.research.card}`}>
        <span class={`inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold ${c.research.pill}`}>Language and cognition</span>
        <h3 class="font-serif text-xl font-semibold mt-3 mb-2">How skills connect</h3>
        <p>A network analysis showed that in autistic children, language, especially pragmatics, sits at the center of theory of mind and other thinking skills. Children with stronger language also did better on theory of mind tasks.</p>
      </div>
      <div class={`rounded-2xl border-t-4 p-6 ${c.research.card}`}>
        <span class={`inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold ${c.research.pill}`}>Bilingualism</span>
        <h3 class="font-serif text-xl font-semibold mt-3 mb-2">Bilingualism and memory</h3>
        <p>With colleagues in Fribourg, I studied monolingual and bilingual autistic children speaking French or German. Working memory helped them understand complex sentences, and bilingualism did not hinder comprehension.</p>
      </div>
      <div class="rounded-2xl p-7 sm:col-span-2 bg-gradient-to-br from-[#2d4f86] to-[#4a77b4] text-white shadow-md dark:from-[#2a3f66] dark:to-[#3d5f93]">
        <span class="inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold bg-white/20 text-white">Next</span>
        <h3 class="font-serif text-2xl font-semibold mt-3 mb-2">From profiles to pathways</h3>
        <p class="text-white/95">My next goal is to understand the pathways behind these profiles: how each child’s language develops over time, what shapes these differences, and whether strong interests, like the one in the clinic story above, can open a way into language.</p>
      </div>
    </div>
  </section>

  <Section title="Why it matters">
    <p class="max-w-[65ch]">Mothers have often asked me, “Why doesn’t anyone understand my child?” Part of the answer may be that we have been looking for one expected profile instead of recognizing many. When assessment and support reflect each child’s own language profile, families and clinicians can understand communication better.</p>
  </Section>

  <Section title="Research stories">
    <a href="/stories/sentence-repetition/" class="block rounded-2xl border-t-4 border-[#8a63b3] dark:border-[#b597d6] bg-[#efe7f6] dark:bg-[#2a2333] p-6 no-underline hover:shadow-md transition-shadow">
      <span class="inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold bg-[#e6dcf0] text-[#59397a] dark:bg-[#352b40] dark:text-[#dcc8f0]">Interactive</span>
      <h3 class="font-serif text-xl font-semibold mt-3 mb-1">Can you say it back?</h3>
      <p>Scroll through one of my studies: the original abstract on one side, and what it means in plain language on the other.</p>
      <p class="mt-3 font-semibold text-accent dark:text-night-accent">Read the story →</p>
    </a>
  </Section>

  <Section title="Projects">
    <Row when="NYU, now"><p>Two-word combinations in autistic and typically developing preschoolers, with Prof. Sudha Arunachalam and Prof. Rhiannon Luyster.</p></Row>
    <Row when="NYU, now"><p>Lexical abilities in Arabic–English bilingual children, measured with eye-tracking and caregiver reports.</p></Row>
    <Row when="Upcoming"><p>Real-time spoken-language comprehension in autism, using eye-tracking and neural measures of speech processing, including the frequency-following response (FFR).</p></Row>
    <Row when="2024–2025"><p>Project coordinator (completed): morpho-lexical and morpho-syntactic development in Arabic-speaking toddlers, an Israel Science Foundation project with Prof. Elinor Saiegh-Haddad, Bar-Ilan University.</p></Row>
  </Section>

  <Section title="Publications">
    {pubs.filter((p) => p.status === "published").map((p) => <Publication pub={p} />)}
  </Section>

  <Section title="Selected talks">
    <div class="flex flex-wrap gap-x-8 gap-y-3 mb-4">
      <div><span class="font-serif text-3xl font-semibold">8</span> <span class="text-muted dark:text-night-muted">invited talks</span></div>
      <div><span class="font-serif text-3xl font-semibold">23</span> <span class="text-muted dark:text-night-muted">conference talks</span></div>
      <div><span class="font-serif text-3xl font-semibold">14</span> <span class="text-muted dark:text-night-muted">posters</span></div>
    </div>
    {talks.map((t) => (
      <Row when={t.date}>
        <span class={`inline-block rounded-md px-2.5 py-0.5 text-[13px] font-semibold ${talkColors[t.type] ?? neutral}`}>{t.type}</span>
        <p class="font-medium mt-1.5">{t.title}</p>
        <p class="text-[15px] text-muted dark:text-night-muted">{t.where}</p>
      </Row>
    ))}
  </Section>
</Base>

