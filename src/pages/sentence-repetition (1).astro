---
import Base from "../../layouts/Base.astro";

// ─────────────────────────────────────────────────────────────
// A scrollytelling story: the original abstract stays on the left,
// and plain-language notes scroll past on the right. As each note
// reaches the middle of the screen, the matching sentence in the
// abstract lights up. On phones, each note shows its own quote.
//
// To make a new story: copy this file, change `paper`, `source`
// and `steps`. Each step lists the source sentence ids it explains.
// ─────────────────────────────────────────────────────────────

const paper = {
  title: "Morphosyntactic skills in Arabic-speaking children with autism spectrum disorder: Evidence from error patterns in the sentence repetition task",
  authors: "Abd El-Raziq, M., Meir, N., & Saiegh-Haddad, E. (2024)",
  journal: "Autism & Developmental Language Impairments, 9",
  doi: "10.1177/23969415241234649",
};

// The original abstract, split into sentences with ids
const source = [
  { heading: "Background and aims" },
  { id: "s1", text: "Although autism spectrum disorder (ASD) has not traditionally been associated with morphosyntactic impairments, some children with ASD manifest significant difficulties in this domain." },
  { id: "s2", text: "Sentence Repetition (SRep) tasks are highly reliable tools for detecting morphosyntactic impairment in different languages and across various populations, including children with ASD." },
  { heading: "Methods" },
  { id: "s3", text: "A total of 142 PA-speaking children, aged 5–11, participated in the study: 75 children with typical language development (TLD) and 67 children with ASD." },
  { id: "s4", text: "The PA SRep task targeted morphosyntactic structures of varying complexity (simple subject-verb-object [SVO] sentences, biclausal sentences, wh-questions, relative clauses)." },
  { heading: "Results" },
  { id: "s5", text: "Two subgroups of ASD emerged: 43% showed age-appropriate language skills (ASD + NL) pairing up with TLD peers, while 57% showed signs of morphosyntactic impairment (ASD + LI)." },
  { id: "s6", text: "Children in both groups exhibited a higher frequency of morphosyntactic errors than pragmatic ones." },
  { id: "s7", text: "Children with ASD + LI showed difficulties with producing complex morphosyntactic structures, such as relative clauses and object wh-questions." },
  { id: "s8", text: "Error analysis revealed that children in the ASD + LI group produced sentence fragments and simplified constructions when complex structures were targeted." },
  { heading: "Conclusions and implications" },
  { id: "s9", text: "The current study extends the cross-linguistic evidence of the heterogeneity of morphosyntactic profiles in children with ASD to Arabic-speaking children." },
  { id: "s10", text: "Our results emphasize the importance of comprehensive language assessment in children with ASD and underscore the need for tailored intervention plans targeting impaired morphosyntactic structures in some children with ASD." },
];
const byId = Object.fromEntries(source.filter((s) => s.id).map((s) => [s.id, s.text]));

// The plain-language notes. `kind` picks a small picture for the note.
const steps = [
  { ids: ["s1"], title: "A question that is often skipped",
    text: "Grammar is not part of an autism diagnosis, so it is often not tested. Yet some autistic children find it hard to build sentences. How many, and in what way?" },
  { ids: ["s2"], title: "A simple way to test grammar",
    text: "Ask a child to repeat a sentence. Short sentences are easy to copy, but a long, complex sentence can only be repeated accurately if your grammar can rebuild it." },
  { ids: ["s3"], kind: "children", title: "142 children took part",
    text: "All were 5 to 11 years old and spoke Palestinian Arabic at home. 75 had typical language development and 67 were autistic." },
  { ids: ["s4"], kind: "sentences", title: "From easy to hard sentences",
    text: "The 36 sentences ranged from simple ones to sentences where words move out of their usual place, which are harder to build." },
  { ids: ["s5"], kind: "split", title: "More than half needed attention",
    text: "In this study, 57% of the autistic children showed clear difficulties with grammar, a part of language that autism assessments often do not test. The other 43% repeated sentences as well as their typically developing peers. Without a language test, these grammar difficulties can easily go unnoticed." },
  { ids: ["s6"], kind: "errors", title: "The mistakes were about grammar",
    text: "In every group, most mistakes were grammatical. Very few were pragmatic, such as answering the question instead of repeating it. So the difficulty was building the sentence, not understanding the task." },
  { ids: ["s7", "s8"], kind: "example", title: "Different children, different mistakes",
    text: "When a sentence was hard, children with grammatical difficulties often shortened it to a fragment. Typically developing children made a different mistake: they turned it into an easier, but complete, sentence." },
  { ids: ["s9"], title: "Arabic joins the evidence",
    text: "Studies in English, Hebrew, French and other languages found the same split. This study shows it in Arabic too. Nonverbal IQ did not predict who struggled." },
  { ids: ["s10"], title: "Why it matters for children",
    text: "Structural language differences, like the grammar difficulties found in more than half of the autistic children here, need attention. An autism diagnosis alone does not tell us about a child’s grammar. Testing language in detail helps clinicians find the children who need grammar support, and plan therapy around the structures they find hard." },
];
---
<Base title="Story: repeating sentences" description="An interactive, plain-language walk through a study of grammar in Arabic-speaking autistic children.">
  <div class="story-wide">
    <a href="/research/" class="text-sm font-semibold text-accent dark:text-night-accent">← Research</a>
    <p class="mt-6 text-sm font-semibold text-[#59397a] dark:text-[#dcc8f0]">Research story</p>
    <h1 class="font-serif text-4xl sm:text-5xl leading-[1.08] tracking-tight mt-1 max-w-[20ch]">Can you say it back?</h1>
    <p class="mt-4 text-lg sm:text-xl text-muted dark:text-night-muted max-w-[60ch]">What repeating sentences reveals about grammar in Arabic-speaking autistic children. Scroll down: on the left is the original abstract, and on the right, what it means.</p>

    <div class="mt-12 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10 lg:gap-14">
      <!-- Left: the original source (desktop only) -->
      <aside class="hidden lg:block">
        <div id="source-panel" class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto rounded-2xl border border-rule dark:border-night-rule bg-white/70 dark:bg-white/[0.03] p-6 text-[15px] leading-relaxed">
          <p class="text-xs font-semibold text-muted dark:text-night-muted">The original abstract</p>
          <p class="font-serif font-semibold mt-1 mb-4 leading-snug">{paper.title}</p>
          {source.map((s) =>
            s.heading
              ? <p class="mt-4 mb-1 font-semibold">{s.heading}</p>
              : <span class="src" data-id={s.id}>{s.text} </span>
          )}
          <p class="mt-5 text-xs text-muted dark:text-night-muted">{paper.authors}. <em>{paper.journal}</em>. Open access under CC BY-NC 4.0.</p>
        </div>
      </aside>

      <!-- Right: plain-language notes -->
      <div>
        {steps.map((st, i) => (
          <section class="step min-h-[55vh] lg:min-h-[70vh] flex items-center" data-ids={st.ids.join(" ")}>
            <div class="card w-full rounded-2xl border border-rule dark:border-night-rule bg-white dark:bg-[#1c2029] p-6 sm:p-7 shadow-sm">
              <p class="text-sm font-semibold text-muted dark:text-night-muted">{i + 1} of {steps.length}</p>
              <h2 class="font-serif text-2xl font-semibold mt-1 mb-3">{st.title}</h2>
              <p>{st.text}</p>

              {st.kind === "children" && (
                <div class="mt-5" aria-hidden="true">
                  <div class="flex flex-wrap gap-1">{Array.from({ length: 75 }).map(() => <span class="size-2.5 rounded-full bg-[#7cc4aa]" />)}</div>
                  <p class="text-sm mt-1.5 mb-3 text-muted dark:text-night-muted">75 typical language development</p>
                  <div class="flex flex-wrap gap-1">{Array.from({ length: 67 }).map(() => <span class="size-2.5 rounded-full bg-[#8a63b3]" />)}</div>
                  <p class="text-sm mt-1.5 text-muted dark:text-night-muted">67 autistic</p>
                </div>
              )}

              {st.kind === "sentences" && (
                <div class="mt-5 space-y-3 text-[15px]">
                  <div class="rounded-lg bg-[#d7ebe3] text-[#22594a] dark:bg-[#1f3a32] dark:text-[#b5e3d2] p-3">
                    <p class="font-semibold">Easier</p>
                    <p class="italic">dʒa:r-na: iʃtara: sijja:ra</p>
                    <p>“Our neighbor bought a car.”</p>
                  </div>
                  <div class="rounded-lg bg-[#f3dad6] text-[#7a3127] dark:bg-[#40272a] dark:text-[#f2c1b9] p-3">
                    <p class="font-semibold">Harder (object relative clause)</p>
                    <p class="italic">il-bubbo illi: ħadˤan-o il-walad akal mo:ze</p>
                    <p>“The baby that the boy hugged ate a banana.”</p>
                  </div>
                </div>
              )}

              {st.kind === "split" && (
                <div class="mt-5" aria-hidden="true">
                  <div class="flex h-10 rounded-lg overflow-hidden text-sm font-semibold">
                    <div class="bg-[#7cc4aa] text-[#123a30] grid place-items-center" style="width:43%">43%</div>
                    <div class="bg-[#8a63b3] text-white grid place-items-center" style="width:57%">57%</div>
                  </div>
                  <div class="flex justify-between text-sm mt-1.5 text-muted dark:text-night-muted"><span>Age-appropriate grammar</span><span>Grammatical difficulties</span></div>
                </div>
              )}

              {st.kind === "errors" && (
                <div class="mt-5 space-y-2 text-sm" aria-hidden="true">
                  {[["Typical language", 93], ["Autistic, age-appropriate grammar", 92], ["Autistic, grammatical difficulties", 83]].map(([label, v]) => (
                    <div>
                      <div class="flex justify-between"><span>{label}</span><span class="font-semibold">{v}% grammatical</span></div>
                      <div class="h-2.5 rounded-full bg-rule dark:bg-night-rule mt-1"><div class="h-2.5 rounded-full bg-accent dark:bg-night-accent" style={`width:${v}%`}></div></div>
                    </div>
                  ))}
                  <p class="text-muted dark:text-night-muted pt-1">Share of all mistakes that were grammatical</p>
                </div>
              )}

              {st.kind === "example" && (
                <div class="mt-5 space-y-2 text-[15px]">
                  <p><span class="font-semibold">Target:</span> “The baby that the boy hugged ate a banana.”</p>
                  <p class="rounded-lg bg-[#e6dcf0] text-[#59397a] dark:bg-[#352b40] dark:text-[#dcc8f0] p-3"><span class="font-semibold">Grammatical difficulties:</span> “He ate a banana.”</p>
                  <p class="rounded-lg bg-[#d7ebe3] text-[#22594a] dark:bg-[#1f3a32] dark:text-[#b5e3d2] p-3"><span class="font-semibold">Typical language:</span> “The baby that hugged the boy ate a banana.”</p>
                </div>
              )}

              <!-- On phones, show the matching sentence from the abstract -->
              <blockquote class="lg:hidden mt-5 border-l-2 border-accent dark:border-night-accent pl-3 text-[14px] text-muted dark:text-night-muted">
                <p class="text-xs font-semibold mb-1">From the abstract</p>
                {st.ids.map((id) => <p>{byId[id]}</p>)}
              </blockquote>
            </div>
          </section>
        ))}
      </div>
    </div>

    <div class="mt-10 max-w-[60ch] rounded-2xl border-t-4 border-[#8a63b3] dark:border-[#b597d6] bg-[#efe7f6] dark:bg-[#2a2333] p-6">
      <h2 class="font-serif text-2xl font-semibold mb-2">Read the full paper</h2>
      <p>{paper.authors}. {paper.title}. <em>{paper.journal}</em>.</p>
      <a class="inline-block mt-3 font-semibold text-accent dark:text-night-accent" href={`https://doi.org/${paper.doi}`}>Open the article (free to read) →</a>
    </div>
  </div>
</Base>

<style is:global>
  /* Let this page be wider than the others, so two columns fit */
  .story-wide {
    width: min(72rem, calc(100vw - 2.5rem));
    margin-left: calc(50% - min(36rem, calc(50vw - 1.25rem)));
  }
  .src { border-radius: 4px; transition: background-color .3s, color .3s; color: var(--color-muted); }
  .dark .src { color: var(--color-night-muted); }
  .src.on { background: #e6dcf0; color: #2b1f3a; }
  .dark .src.on { background: #3a2e48; color: #f1e8fa; }
  .step .card { transition: opacity .3s, transform .3s; }
  @media (min-width: 1024px) {
    .step:not(.on) .card { opacity: .45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .src, .step .card { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var steps = document.querySelectorAll(".step");
    var panel = document.getElementById("source-panel");
    function activate(step) {
      steps.forEach(function (s) { s.classList.toggle("on", s === step); });
      var ids = step.dataset.ids.split(" ");
      var first = null;
      document.querySelectorAll(".src").forEach(function (el) {
        var on = ids.indexOf(el.dataset.id) > -1;
        el.classList.toggle("on", on);
        if (on && !first) first = el;
      });
      // Keep the highlighted sentence visible inside the source panel
      if (panel && first && panel.offsetParent !== null) {
        var top = first.offsetTop - panel.clientHeight / 3;
        panel.scrollTo({ top: Math.max(0, top), behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      }
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) activate(e.target); });
    }, { rootMargin: "-45% 0px -45% 0px" });
    steps.forEach(function (s) { io.observe(s); });
    if (steps[0]) activate(steps[0]);
  })();
</script>
